# RAG — Qdrant Cloud (cloud.qdrant.io → your cluster → API Keys)
QDRANT_URL=https://xxx.cloud.qdrant.io
QDRANT_API_KEY=xxx

# RAG — OpenAI Embeddings (platform.openai.com → API Keys)
OPENAI_API_KEY=sk-xxx

# Chat + reranking — Groq (console.groq.com → API Keys)
GROQ_API_KEY_NEW=gsk_xxx

# Voice rate limiting only (not used for RAG anymore) — Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Judge/eval scripts only (not used for the live chat anymore) — Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxx
